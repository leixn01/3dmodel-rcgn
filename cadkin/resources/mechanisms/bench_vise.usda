            uniform token[] xformOpOrder = ["!resetXformStack!", "xformOp:transform"]

            def Xform "Body" (
                prepend apiSchemas = ["PhysicsRigidBodyAPI"]
                customData = {
                    dictionary cadkin = {
                        int sourceColliderCount = 11
                        string[] sourceGeometryMembers = ["/Model/Geometry/Base/Body/Fixed_jaw_insert/Serrated_Insert/Serrated_Insert_mesh", "/Model/Geometry/Base/Body/Fixed_jaw_insert/Screws/Screws_mesh", "/Model/Geometry/Base/Body/Casting/Casting_mesh", "/Model/Geometry/Base/Body/Anvil_Face/Anvil_Face_mesh", "/Model/Geometry/Base/Body/Pipe_Jaw/Pipe_Jaw_mesh", "/Model/Geometry/Base/Body/Nut/Nut_mesh", "/Model/Geometry/Base/Body/Lock_Studs/Lock_Studs_mesh"]
                    }
                }
