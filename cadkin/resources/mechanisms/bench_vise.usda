            )
            {
                float drive:angular:physics:damping = 0.000349066
                float drive:angular:physics:stiffness = 0
                float drive:angular:physics:targetVelocity = 0
                uniform token drive:angular:physics:type = "force"
                uniform token physics:axis = "X"
                rel physics:body0 = </Model/Geometry/Base/Body>
                rel physics:body1 = </Model/Geometry/Base/Body/Lock_lever_1>
                point3f physics:localPos0 = (-0.056, 0, 0.012)
                point3f physics:localPos1 = (0, 0, 0)
                quatf physics:localRot0 = (-0.5, 0.5, 0.5, 0.5)
