    def "Physics"
    {
        def Scope "Joints"
        {
            def PhysicsRevoluteJoint "swivel" (
                apiSchemas = ["PhysicsDriveAPI:angular", "PhysicsJointStateAPI:angular"]
            )
            {
                float drive:angular:physics:damping = 0.034906585
                float drive:angular:physics:stiffness = 0
                float drive:angular:physics:targetVelocity = 0
                uniform token drive:angular:physics:type = "force"
                uniform token physics:axis = "X"
                rel physics:body0 = </Model/Geometry/Base>
                rel physics:body1 = </Model/Geometry/Base/Body>
                point3f physics:localPos0 = (0, 0, 0.02)
                point3f physics:localPos1 = (0, 0, 0)
                quatf physics:localRot0 = (-0.5, 0.5, 0.5, 0.5)
                quatf physics:localRot1 = (-0.5, 0.5, 0.5, 0.5)
                float physics:lowerLimit = 0
                float physics:upperLimit = 360
                float state:angular:physics:position = 0
                float state:angular:physics:velocity = 0
            }

            def PhysicsPrismaticJoint "jaw" (
                apiSchemas = ["PhysicsDriveAPI:linear", "PhysicsJointStateAPI:linear"]
            )
            {
                float drive:linear:physics:damping = 50
                float drive:linear:physics:stiffness = 0
                float drive:linear:physics:targetVelocity = 0
                uniform token drive:linear:physics:type = "force"
                uniform token physics:axis = "X"
                rel physics:body0 = </Model/Geometry/Base/Body>
                rel physics:body1 = </Model/Geometry/Base/Body/Sliding_jaw>
                point3f physics:localPos0 = (0, -0.08, 0.033)
                point3f physics:localPos1 = (0, 0, 0)
                quatf physics:localRot0 = (0.70710677, 0, 0, -0.70710677)
                quatf physics:localRot1 = (0.70710677, 0, 0, -0.70710677)
                float physics:lowerLimit = 0
                float physics:upperLimit = 0.125
                float state:linear:physics:position = 0.05
                float state:linear:physics:velocity = 0
            }

            def PhysicsRevoluteJoint "screw" (
                apiSchemas = ["PhysicsDriveAPI:angular", "PhysicsJointStateAPI:angular"]
            )
            {
                float drive:angular:physics:damping = 0.000872665
                float drive:angular:physics:stiffness = 0
                float drive:angular:physics:targetVelocity = 0
                uniform token drive:angular:physics:type = "force"
                uniform token physics:axis = "X"
                rel physics:body0 = </Model/Geometry/Base/Body/Sliding_jaw>
                rel physics:body1 = </Model/Geometry/Base/Body/Sliding_jaw/Screw>
                uniform bool physics:excludeFromArticulation = 1
                point3f physics:localPos0 = (0, -0.038, 0)
                point3f physics:localPos1 = (0, 0, 0)
                quatf physics:localRot0 = (0.70710677, 0, 0, -0.70710677)
                quatf physics:localRot1 = (0.70710677, 0, 0, -0.70710677)
                float physics:lowerLimit = 0
                float physics:upperLimit = 9000
                float state:angular:physics:position = 3600
                float state:angular:physics:velocity = 0
            }

            def PhysicsPrismaticJoint "handle_slide" (
                apiSchemas = ["PhysicsDriveAPI:linear", "PhysicsJointStateAPI:linear"]
            )
            {
                float drive:linear:physics:damping = 2
                float drive:linear:physics:stiffness = 0
                float drive:linear:physics:targetVelocity = 0
                uniform token drive:linear:physics:type = "force"
                uniform token physics:axis = "X"
                rel physics:body0 = </Model/Geometry/Base/Body/Sliding_jaw/Screw>
                rel physics:body1 = </Model/Geometry/Base/Body/Sliding_jaw/Screw/Handle_bar>
                point3f physics:localPos0 = (0, -0.018, 0)
                point3f physics:localPos1 = (0, 0, 0)
                quatf physics:localRot0 = (1, 0, 0, 0)
                quatf physics:localRot1 = (1, 0, 0, 0)
                float physics:lowerLimit = -0.08331
                float physics:upperLimit = 0.08331
                float state:linear:physics:position = 0
                float state:linear:physics:velocity = 0
